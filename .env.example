# Copy to `.env.local` (gitignored) or set these in the deployment's
# environment. The client reads them at build time.
#
# The project URL has a default in src/integrations/supabase/client.ts, so in
# practice only the key must be set. Both values are public: the publishable
# key identifies the project and carries no privileges of its own, and Row
# Level Security is the real access boundary.
#
# The SERVICE ROLE key bypasses RLS entirely. It must never appear in this
# repository, in a client bundle, or under any name with a VITE_ prefix.

VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
